        {"agents": 8, "ok": true, "replies": 8, "time_s": 18.1},
        {"agents": 16, "ok": true, "replies": 16, "time_s": 19.9},
        {"agents": 32, "ok": true, "replies": 32, "time_s": 19.7},
        {"agents": 64, "ok": true, "replies": 64, "time_s": 23.0},
